{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.zt.silverfish_minion.cast": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"casting": "q.property('zt:casting')"
						}
					],
					"blend_transition": 0.2
				},
				"casting": {
					"animations": [
						"cast_rear"
					],
					"transitions": [
						{
							"default": "!q.property('zt:casting')"
						}
					],
					"blend_transition": 0.2
				}
			}
		}
	}
}
