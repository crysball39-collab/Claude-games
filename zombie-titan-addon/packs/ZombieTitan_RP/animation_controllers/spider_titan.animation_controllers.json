{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.zt.spider.main": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						"idle"
					],
					"transitions": [
						{
							"birth": "q.property('zt:anim') == 13"
						},
						{
							"walk": "q.property('zt:anim') == 0 && q.property('zt:moving')"
						},
						{
							"smash": "q.property('zt:anim') == 3"
						},
						{
							"anti_air": "q.property('zt:anim') == 4"
						},
						{
							"sweep": "q.property('zt:anim') == 5"
						},
						{
							"web": "q.property('zt:anim') == 6"
						},
						{
							"lightning": "q.property('zt:anim') == 7"
						},
						{
							"stun": "q.property('zt:anim') == 8"
						},
						{
							"clap": "q.property('zt:anim') == 9"
						},
						{
							"awaken": "q.property('zt:anim') == 11"
						},
						{
							"leap": "q.property('zt:anim') == 14"
						}
					],
					"blend_transition": 0.3
				},
				"walk": {
					"animations": [
						"walk"
					],
					"transitions": [
						{
							"default": "q.property('zt:anim') != 0 || !q.property('zt:moving')"
						}
					],
					"blend_transition": 0.3
				},
				"birth": {
					"animations": [
						"birth"
					],
					"transitions": [
						{
							"default": "q.property('zt:anim') != 13"
						}
					],
					"blend_transition": 0.6
				},
				"smash": {
					"animations": [
						"smash"
					],
					"transitions": [
						{
							"default": "q.property('zt:anim') != 3"
						}
					],
					"blend_transition": 0.25
				},
				"anti_air": {
					"animations": [
						"anti_air"
					],
					"transitions": [
						{
							"default": "q.property('zt:anim') != 4"
						}
					],
					"blend_transition": 0.25
				},
				"sweep": {
					"animations": [
						"sweep"
					],
					"transitions": [
						{
							"default": "q.property('zt:anim') != 5"
						}
					],
					"blend_transition": 0.25
				},
				"web": {
					"animations": [
						"web"
					],
					"transitions": [
						{
							"default": "q.property('zt:anim') != 6"
						}
					],
					"blend_transition": 0.25
				},
				"lightning": {
					"animations": [
						"lightning"
					],
					"transitions": [
						{
							"default": "q.property('zt:anim') != 7"
						}
					],
					"blend_transition": 0.25
				},
				"stun": {
					"animations": [
						"stun"
					],
					"transitions": [
						{
							"default": "q.property('zt:anim') != 8"
						}
					],
					"blend_transition": 0.25
				},
				"clap": {
					"animations": [
						"clap"
					],
					"transitions": [
						{
							"default": "q.property('zt:anim') != 9"
						}
					],
					"blend_transition": 0.25
				},
				"awaken": {
					"animations": [
						"awaken"
					],
					"transitions": [
						{
							"default": "q.property('zt:anim') != 11"
						}
					],
					"blend_transition": 0.25
				},
				"leap": {
					"animations": [
						"leap"
					],
					"transitions": [
						{
							"default": "q.property('zt:anim') != 14"
						}
					],
					"blend_transition": 0.25
				}
			}
		}
	}
}
