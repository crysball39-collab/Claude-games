{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.zt.door": {
			"initial_state": "closed",
			"states": {
				"closed": {
					"transitions": [
						{
							"opening": "q.property('zt:open')"
						}
					]
				},
				"opening": {
					"animations": [
						"open"
					],
					"transitions": [
						{
							"closing": "!q.property('zt:open')"
						}
					]
				},
				"closing": {
					"animations": [
						"close"
					],
					"transitions": [
						{
							"opening": "q.property('zt:open')"
						},
						{
							"closed": "q.all_animations_finished"
						}
					]
				}
			}
		},
		"controller.animation.zt.hand": {
			"initial_state": "hidden",
			"states": {
				"hidden": {
					"transitions": [
						{
							"burst": "q.property('zt:anim') == 1"
						},
						{
							"grab": "q.property('zt:anim') == 2"
						}
					]
				},
				"burst": {
					"animations": [
						"burst"
					],
					"transitions": [
						{
							"grope": "q.all_animations_finished"
						},
						{
							"grab": "q.property('zt:anim') == 2"
						},
						{
							"hidden": "q.property('zt:anim') == 0"
						}
					]
				},
				"grope": {
					"animations": [
						"grope"
					],
					"transitions": [
						{
							"grab": "q.property('zt:anim') == 2"
						},
						{
							"hidden": "q.property('zt:anim') == 0"
						}
					],
					"blend_transition": 0.15
				},
				"grab": {
					"animations": [
						"grab"
					],
					"transitions": [
						{
							"grope": "q.property('zt:anim') == 1"
						},
						{
							"hidden": "q.property('zt:anim') == 0"
						}
					],
					"blend_transition": 0.1
				}
			}
		},
		"controller.animation.zt.chandelier": {
			"initial_state": "hang",
			"states": {
				"hang": {
					"animations": [
						"hang"
					],
					"transitions": [
						{
							"fall": "q.property('zt:state') == 1"
						},
						{
							"fallen": "q.property('zt:state') == 2"
						}
					]
				},
				"fall": {
					"animations": [
						"fall"
					],
					"transitions": [
						{
							"fallen": "q.property('zt:state') == 2"
						},
						{
							"hang": "q.property('zt:state') == 0"
						}
					]
				},
				"fallen": {
					"animations": [
						"fallen"
					],
					"transitions": [
						{
							"hang": "q.property('zt:state') == 0"
						}
					]
				}
			}
		},
		"controller.animation.zt.library_lamp": {
			"initial_state": "standing",
			"states": {
				"standing": {
					"transitions": [
						{
							"fallen": "q.property('zt:fallen')"
						}
					]
				},
				"fallen": {
					"animations": [
						"fall"
					],
					"transitions": [
						{
							"standing": "!q.property('zt:fallen')"
						}
					]
				}
			}
		}
	}
}
