{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.zt.metal_door": {
			"initial_state": "still",
			"states": {
				"still": {
					"transitions": [
						{
							"bang": "q.property('zt:bang') && !q.property('zt:broken') && !q.property('zt:open')"
						}
					]
				},
				"bang": {
					"animations": [
						"bang"
					],
					"transitions": [
						{
							"still": "!q.property('zt:bang') && q.all_animations_finished"
						}
					]
				}
			}
		},
		"controller.animation.zt.rush": {
			"initial_state": "fly",
			"states": {
				"fly": {
					"animations": [
						"fly"
					],
					"transitions": [
						{
							"sink": "q.property('zt:anim') == 1"
						}
					]
				},
				"sink": {
					"animations": [
						"sink"
					],
					"transitions": [
						{
							"fly": "q.property('zt:anim') == 0"
						}
					]
				}
			}
		},
		"controller.animation.zt.screech": {
			"initial_state": "lurk",
			"states": {
				"lurk": {
					"animations": [
						"lurk"
					],
					"transitions": [
						{
							"bite": "q.property('zt:anim') == 1"
						},
						{
							"flee": "q.property('zt:anim') == 2"
						},
						{
							"sink": "q.property('zt:anim') == 3"
						}
					]
				},
				"bite": {
					"animations": [
						"bite"
					],
					"transitions": [
						{
							"lurk": "q.property('zt:anim') == 0"
						},
						{
							"flee": "q.property('zt:anim') == 2"
						},
						{
							"sink": "q.property('zt:anim') == 3"
						}
					]
				},
				"flee": {
					"animations": [
						"flee"
					],
					"transitions": [
						{
							"lurk": "q.property('zt:anim') == 0"
						}
					]
				},
				"sink": {
					"animations": [
						"sink"
					],
					"transitions": [
						{
							"lurk": "q.property('zt:anim') == 0"
						}
					]
				}
			}
		}
	}
}
