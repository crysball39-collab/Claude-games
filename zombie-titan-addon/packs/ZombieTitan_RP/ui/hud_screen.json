{
	"namespace": "hud",

	// Every boss bar goes through this panel. A bar whose name contains "Zombie Titan" or
	// "Skeleton Titan" (the minecraft:boss names in the titans' behaviour files) gets that
	// titan's own bar; all others keep the vanilla look. The panel is 36 tall (vanilla: 20)
	// so a second boss bar clears the taller titan bars.
	"boss_health_panel": {
		"type": "panel",
		"size": [
			182,
			36
		],
		"anchor_from": "top_middle",
		"anchor_to": "top_middle",
		"$progress_bar_collection": "boss_bars",
		"controls": [
			{
				"zt_vanilla_boss_bar": {
					"type": "panel",
					"size": [
						"100%",
						"100%"
					],
					"controls": [
						{
							"boss_name@hud.boss_name_panel": {}
						},
						{
							"progress_bar_for_collections@common.progress_bar_for_collections": {
								"offset": [
									0,
									10
								]
							}
						}
					],
					"bindings": [
						{
							"binding_type": "collection",
							"binding_collection_name": "boss_bars",
							"binding_name": "#bossName"
						},
						{
							"binding_type": "view",
							"source_property_name": "(((#bossName - 'Zombie Titan') = #bossName) and ((#bossName - 'Skeleton Titan') = #bossName))",
							"target_property_name": "#visible"
						}
					]
				}
			},
			{
				"zt_titan_bar@hud.zt_titan_bar": {}
			},
			{
				"zt_skeleton_bar@hud.zt_skeleton_bar": {}
			}
		],
		"bindings": [
			{
				"binding_name": "#bar_visible",
				"binding_type": "collection",
				"binding_collection_name": "boss_bars",
				"binding_name_override": "#visible"
			}
		]
	},
	"zt_titan_bar": {
		"type": "panel",
		"size": [
			200,
			34
		],
		"anchor_from": "top_middle",
		"anchor_to": "top_middle",
		"controls": [
			{
				"titan_name@hud.boss_name_panel": {}
			},
			{
				"titan_frame_panel": {
					"type": "panel",
					"size": [
						200,
						26
					],
					"offset": [
						0,
						8
					],
					"anchor_from": "top_middle",
					"anchor_to": "top_middle",
					"controls": [
						{
							"titan_back": {
								"type": "image",
								"texture": "textures/ui/zt/titan_bar_back",
								"size": [
									182,
									6
								],
								"offset": [
									0,
									13
								],
								"anchor_from": "top_middle",
								"anchor_to": "top_middle",
								"layer": 1
							}
						},
						{
							"titan_fill": {
								"type": "image",
								"texture": "textures/ui/zt/titan_bar_fill",
								"size": [
									182,
									6
								],
								"offset": [
									0,
									13
								],
								"anchor_from": "top_middle",
								"anchor_to": "top_middle",
								"layer": 2,
								"clip_direction": "left",
								"clip_pixelperfect": false,
								"bindings": [
									{
										"binding_name": "#progress_percentage",
										"binding_name_override": "#clip_ratio",
										"binding_type": "collection",
										"binding_collection_name": "boss_bars"
									}
								]
							}
						},
						{
							"titan_frame": {
								"type": "image",
								"texture": "textures/ui/zt/titan_bar_frame",
								"size": [
									200,
									26
								],
								"anchor_from": "top_middle",
								"anchor_to": "top_middle",
								"layer": 3
							}
						}
					]
				}
			}
		],
		"bindings": [
			{
				"binding_type": "collection",
				"binding_collection_name": "boss_bars",
				"binding_name": "#bossName"
			},
			{
				"binding_type": "view",
				"source_property_name": "(not ((#bossName - 'Zombie Titan') = #bossName))",
				"target_property_name": "#visible"
			}
		]
	},
	"zt_skeleton_bar": {
		"type": "panel",
		"size": [
			200,
			34
		],
		"anchor_from": "top_middle",
		"anchor_to": "top_middle",
		"controls": [
			{
				"skeleton_name@hud.boss_name_panel": {}
			},
			{
				"skeleton_frame_panel": {
					"type": "panel",
					"size": [
						200,
						26
					],
					"offset": [
						0,
						8
					],
					"anchor_from": "top_middle",
					"anchor_to": "top_middle",
					"controls": [
						{
							"skeleton_back": {
								"type": "image",
								"texture": "textures/ui/zt/skeleton_bar_back",
								"size": [
									182,
									6
								],
								"offset": [
									0,
									13
								],
								"anchor_from": "top_middle",
								"anchor_to": "top_middle",
								"layer": 1
							}
						},
						{
							"skeleton_fill": {
								"type": "image",
								"texture": "textures/ui/zt/skeleton_bar_fill",
								"size": [
									182,
									6
								],
								"offset": [
									0,
									13
								],
								"anchor_from": "top_middle",
								"anchor_to": "top_middle",
								"layer": 2,
								"clip_direction": "left",
								"clip_pixelperfect": false,
								"bindings": [
									{
										"binding_name": "#progress_percentage",
										"binding_name_override": "#clip_ratio",
										"binding_type": "collection",
										"binding_collection_name": "boss_bars"
									}
								]
							}
						},
						{
							"skeleton_frame": {
								"type": "image",
								"texture": "textures/ui/zt/skeleton_bar_frame",
								"size": [
									200,
									26
								],
								"anchor_from": "top_middle",
								"anchor_to": "top_middle",
								"layer": 3
							}
						}
					]
				}
			}
		],
		"bindings": [
			{
				"binding_type": "collection",
				"binding_collection_name": "boss_bars",
				"binding_name": "#bossName"
			},
			{
				"binding_type": "view",
				"source_property_name": "(not ((#bossName - 'Skeleton Titan') = #bossName))",
				"target_property_name": "#visible"
			}
		]
	}
}
