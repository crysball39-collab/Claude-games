						"math.cos(q.life_time * 103.1) * 2.9 + 2.9"
					]
				},
				"leftArm": {
					"rotation": [
						"-90 - math.sin((v.attack_time ?? 0) * 180) * 60 - math.sin(q.life_time * 76.8) * 2.9",
						"5",
						"-math.cos(q.life_time * 103.1) * 2.9 - 2.9"
					]
				}
			}
		},
		"animation.zt.minion.cast": {
			"loop": true,
			"bones": {
				"rightArm": {
					"rotation": [
						"-150 + math.sin(q.life_time * 400) * 6",
						0,
						"30"
					]
				},
				"leftArm": {
					"rotation": [
						"-150 - math.sin(q.life_time * 400) * 6",
						0,
						"-30"
					]
				}
			}
		}
