{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "zt:ambush_mist",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/zt_smoke"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 40,
				"max_particles": 120
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 1.3,
				"direction": "outwards",
				"offset": [
					0,
					1.1,
					0
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.6 + v.particle_random_1 * 0.6"
			},
			"minecraft:particle_initial_speed": "0.4 + v.particle_random_2 * 0.6",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 1.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(1.0 + v.particle_random_3 * 1.2) * (0.6 + v.particle_age / v.particle_lifetime * 0.8)",
					"(1.0 + v.particle_random_3 * 1.2) * (0.6 + v.particle_age / v.particle_lifetime * 0.8)"
				],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 64,
					"texture_height": 16,
					"flipbook": {
						"base_UV": [
							0,
							0
						],
						"size_UV": [
							16,
							16
						],
						"step_UV": [
							16,
							0
						],
						"frames_per_second": 6,
						"max_frame": 4,
						"stretch_to_lifetime": true,
						"loop": false
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"gradient": {
						"0.0": [
							0.35,
							0.95,
							0.45,
							0.8
						],
						"0.5": [
							0.15,
							0.6,
							0.25,
							0.5
						],
						"1.0": [
							0.05,
							0.3,
							0.1,
							0.0
						]
					},
					"interpolant": "v.particle_age / v.particle_lifetime"
				}
			}
		}
	}
}
