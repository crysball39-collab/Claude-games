{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "zt:dark_beam",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/zt_glow"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.min(120, v.len * 2.5)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					"v.dir.x * v.particle_random_1 * v.len + (v.particle_random_2 - 0.5) * 1.1",
					"v.dir.y * v.particle_random_1 * v.len + (v.particle_random_3 - 0.5) * 1.1",
					"v.dir.z * v.particle_random_1 * v.len + (v.particle_random_4 - 0.5) * 1.1"
				],
				"direction": [
					"v.dir.x",
					"v.dir.y",
					"v.dir.z"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.14 + v.particle_random_2 * 0.1"
			},
			"minecraft:particle_initial_speed": 3.0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"1.0 + v.particle_random_3 * 0.8",
					"1.0 + v.particle_random_3 * 0.8"
				],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 32,
					"texture_height": 32,
					"uv": [
						0,
						0
					],
					"uv_size": [
						32,
						32
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"gradient": {
						"0.0": [
							0.16,
							0.0,
							0.26,
							0.95
						],
						"0.5": [
							0.3,
							0.02,
							0.46,
							0.85
						],
						"1.0": [
							0.04,
							0.0,
							0.07,
							0.0
						]
					},
					"interpolant": "v.particle_age / v.particle_lifetime"
				}
			}
		}
	}
}
