{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "zt:web_strand",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/zt_spark"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.min(140, v.len * 3)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					"v.dir.x * v.particle_random_1 * v.len + (v.particle_random_2 - 0.5) * 0.5",
					"v.dir.y * v.particle_random_1 * v.len + (v.particle_random_3 - 0.5) * 0.5",
					"v.dir.z * v.particle_random_1 * v.len + (v.particle_random_4 - 0.5) * 0.5"
				],
				"direction": [
					"v.dir.x",
					"v.dir.y",
					"v.dir.z"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.6 + v.particle_random_2 * 0.5"
			},
			"minecraft:particle_initial_speed": 0.2,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					-1.5,
					0
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.22 + v.particle_random_3 * 0.18",
					"0.22 + v.particle_random_3 * 0.18"
				],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [
						0,
						0
					],
					"uv_size": [
						16,
						16
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"gradient": {
						"0.0": [
							0.95,
							0.95,
							0.92,
							1.0
						],
						"0.7": [
							0.88,
							0.88,
							0.86,
							0.9
						],
						"1.0": [
							0.8,
							0.8,
							0.8,
							0.0
						]
					},
					"interpolant": "v.particle_age / v.particle_lifetime"
				}
			}
		}
	}
}
