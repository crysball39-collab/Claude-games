{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "zt:hotel_door",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/entity/doors/hotel_door"
			},
			"geometry": {
				"default": "geometry.zt.hotel_door"
			},
			"render_controllers": [
				"controller.render.zt.hotel_door"
			],
			"scripts": {
				"initialize": [
					"v.open = (q.property('zt:open')) ? 1.0 : 0.0;"
				],
				"pre_animation": [
					"v.open = math.clamp(v.open + ((q.property('zt:open')) ? q.delta_time / 0.50 : -q.delta_time / 0.25), 0.0, 1.0);",
					"v.swing = v.open * v.open * (3.0 - 2.0 * v.open);"
				],
				"animate": [
					"face",
					"swing"
				]
			},
			"animations": {
				"swing": "animation.zt.door.swing",
				"face": "animation.zt.prop.face"
			}
		}
	}
}
