{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "zt:wardrobe",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/entity/hotel/wardrobe_0",
				"wardrobe_1": "textures/entity/hotel/wardrobe_1",
				"wardrobe_2": "textures/entity/hotel/wardrobe_2"
			},
			"geometry": {
				"default": "geometry.zt.wardrobe"
			},
			"render_controllers": [
				"controller.render.zt.wardrobe"
			],
			"scripts": {
				"initialize": [
					"v.open = (q.property('zt:open')) ? 1.0 : 0.0;"
				],
				"pre_animation": [
					"v.open = math.clamp(v.open + ((q.property('zt:open')) ? q.delta_time / 0.20 : -q.delta_time / 0.25), 0.0, 1.0);",
					"v.swing = v.open * v.open * (3.0 - 2.0 * v.open);"
				],
				"animate": [
					"face",
					"swing"
				]
			},
			"animations": {
				"face": "animation.zt.prop.face",
				"swing": "animation.zt.wardrobe.swing"
			}
		}
	}
}
