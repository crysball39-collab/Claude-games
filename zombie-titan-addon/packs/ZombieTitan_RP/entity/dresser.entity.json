{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "zt:dresser",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/entity/hotel/dresser",
				"nightstand": "textures/entity/hotel/nightstand",
				"desk": "textures/entity/hotel/desk"
			},
			"geometry": {
				"default": "geometry.zt.dresser",
				"nightstand": "geometry.zt.nightstand",
				"desk": "geometry.zt.desk"
			},
			"render_controllers": [
				"controller.render.zt.dresser"
			],
			"scripts": {
				"initialize": [
					"v.d0 = math.mod(math.floor(q.property('zt:drawers') / 1), 2);",
					"v.d1 = math.mod(math.floor(q.property('zt:drawers') / 2), 2);",
					"v.d2 = math.mod(math.floor(q.property('zt:drawers') / 4), 2);"
				],
				"pre_animation": [
					"v.d0 = math.lerp(v.d0, math.mod(math.floor(q.property('zt:drawers') / 1), 2), math.min(1.0, q.delta_time * 12.0));",
					"v.d1 = math.lerp(v.d1, math.mod(math.floor(q.property('zt:drawers') / 2), 2), math.min(1.0, q.delta_time * 12.0));",
					"v.d2 = math.lerp(v.d2, math.mod(math.floor(q.property('zt:drawers') / 4), 2), math.min(1.0, q.delta_time * 12.0));"
				],
				"animate": [
					"face",
					"drawers"
				]
			},
			"animations": {
				"face": "animation.zt.prop.face",
				"drawers": "animation.zt.drawers"
			}
		}
	}
}
