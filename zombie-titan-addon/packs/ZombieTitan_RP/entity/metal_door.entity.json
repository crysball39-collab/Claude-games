{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "zt:metal_door",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/entity/hotel/metal_door"
			},
			"geometry": {
				"default": "geometry.zt.metal_door"
			},
			"render_controllers": [
				"controller.render.zt.metal_door"
			],
			"scripts": {
				"initialize": [
					"v.open = (q.property('zt:open') && !q.property('zt:broken')) ? 1.0 : 0.0;",
					"v.broken = q.property('zt:broken') ? 1.0 : 0.0;"
				],
				"pre_animation": [
					"v.open = math.clamp(v.open + ((q.property('zt:open') && !q.property('zt:broken')) ? q.delta_time / 0.50 : -q.delta_time / 0.25), 0.0, 1.0);",
					"v.swing = v.open * v.open * (3.0 - 2.0 * v.open);",
					"v.broken = math.clamp(v.broken + (q.property('zt:broken') ? q.delta_time / 0.6 : -1.0), 0.0, 1.0);"
				],
				"animate": [
					"face",
					"swing",
					"hit"
				]
			},
			"animations": {
				"face": "animation.zt.prop.face",
				"swing": "animation.zt.metal_door.swing",
				"bang": "animation.zt.metal_door.bang",
				"hit": "controller.animation.zt.metal_door"
			}
		}
	}
}
