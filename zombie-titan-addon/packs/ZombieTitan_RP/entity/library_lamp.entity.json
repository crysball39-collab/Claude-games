{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "zt:library_lamp",
			"materials": {
				"default": "entity_emissive_alpha"
			},
			"textures": {
				"default": "textures/entity/doors/library_lamp"
			},
			"geometry": {
				"default": "geometry.zt.library_lamp"
			},
			"render_controllers": [
				"controller.render.zt.default"
			],
			"scripts": {
				"initialize": [
					"v.fall = q.property('zt:fallen') ? 1.0 : 0.0;"
				],
				"pre_animation": [
					"v.fall = math.clamp(v.fall + (q.property('zt:fallen') ? q.delta_time / 0.55 : -1.0), 0.0, 1.0);"
				],
				"animate": [
					"face",
					"fall"
				]
			},
			"animations": {
				"fall": "animation.zt.library_lamp.fall",
				"face": "animation.zt.prop.face"
			}
		}
	}
}
