{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "zt:wall_lever",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/entity/hotel/wall_lever"
			},
			"geometry": {
				"default": "geometry.zt.wall_lever"
			},
			"render_controllers": [
				"controller.render.zt.default"
			],
			"scripts": {
				"initialize": [
					"v.pull = q.property('zt:on') ? 1.0 : 0.0;"
				],
				"pre_animation": [
					"v.pull = math.lerp(v.pull, q.property('zt:on') ? 1.0 : 0.0, math.min(1.0, q.delta_time * 5.0));"
				],
				"animate": [
					"face",
					"pull"
				]
			},
			"animations": {
				"face": "animation.zt.prop.face",
				"pull": "animation.zt.wall_lever.pull"
			}
		}
	}
}
