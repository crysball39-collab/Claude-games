{
	"format_version": "1.21.90",
	"minecraft:entity": {
		"description": {
			"identifier": "zt:breaker_box",
			"is_spawnable": false,
			"is_summonable": true,
			"properties": {
				"zt:yaw": {
					"type": "int",
					"range": [
						-180,
						180
					],
					"default": 0,
					"client_sync": true
				},
				"zt:open": {
					"type": "bool",
					"default": false,
					"client_sync": true
				},
				"zt:num": {
					"type": "int",
					"range": [
						0,
						11
					],
					"default": 0,
					"client_sync": true
				},
				"zt:fill": {
					"type": "int",
					"range": [
						0,
						2
					],
					"default": 0,
					"client_sync": true
				},
				"zt:ok": {
					"type": "bool",
					"default": false,
					"client_sync": true
				},
				"zt:slots": {
					"type": "int",
					"range": [
						0,
						10
					],
					"default": 0,
					"client_sync": true
				}
			}
		},
		"components": {
			"minecraft:type_family": {
				"family": [
					"zt_door100",
					"zt_doors_prop",
					"inanimate"
				]
			},
			"minecraft:health": {
				"value": 1,
				"max": 1
			},
			"minecraft:collision_box": {
				"width": 0.36,
				"height": 2.5
			},
			"minecraft:physics": {
				"has_gravity": false,
				"has_collision": false
			},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": false
			},
			"minecraft:knockback_resistance": {
				"value": 1.0
			},
			"minecraft:fire_immune": {},
			"minecraft:persistent": {},
			"minecraft:nameable": {
				"allow_name_tag_renaming": false
			},
			"minecraft:breathable": {
				"breathes_air": true,
				"breathes_water": true,
				"suffocate_time": 0
			},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"cause": "all",
						"deals_damage": "no"
					}
				]
			},
			"minecraft:interact": {
				"interactions": [
					{
						"on_interact": {
							"filters": {
								"test": "is_family",
								"subject": "other",
								"value": "player"
							},
							"event": "zt:interacted",
							"target": "self"
						},
						"swing": true,
						"interact_text": "action.interact.zt_use"
					}
				]
			}
		},
		"events": {
			"zt:interacted": {}
		}
	}
}
