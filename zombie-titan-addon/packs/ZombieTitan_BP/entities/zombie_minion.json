{
	"format_version": "1.21.90",
	"minecraft:entity": {
		"description": {
			"identifier": "zt:zombie_minion",
			"is_spawnable": true,
			"is_summonable": true,
			"spawn_category": "monster",
			"properties": {
				"zt:casting": {"type": "bool", "default": false, "client_sync": true}
			}
		},
		"component_groups": {
			"zt:loyalist": {
				"minecraft:variant": {"value": 0},
				"minecraft:health": {"value": 30, "max": 30},
