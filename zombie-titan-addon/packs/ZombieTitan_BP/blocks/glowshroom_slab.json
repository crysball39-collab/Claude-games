{
	"format_version": "1.26.20",
	"minecraft:block": {
		"description": {
			"identifier": "zt:glowshroom_slab",
			"menu_category": {
				"category": "construction",
				"group": "minecraft:itemGroup.name.slab"
			},
			"states": {
				"zt:double": {
					"values": {
						"min": 0,
						"max": 1
					}
				}
			},
			"traits": {
				"minecraft:placement_position": {
					"enabled_states": [
						"minecraft:vertical_half"
					]
				}
			}
		},
		"components": {
			"minecraft:geometry": {
				"identifier": "geometry.zt.glowshroom_slab",
				"bone_visibility": {
					"lower": "q.block_state('minecraft:vertical_half') == 'bottom' || q.block_state('zt:double') == 1",
					"upper": "q.block_state('minecraft:vertical_half') == 'top' || q.block_state('zt:double') == 1"
				}
			},
			"minecraft:material_instances": {
				"*": {
					"texture": "zt_glowshroom_planks",
					"render_method": "opaque"
				}
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 2
			},
			"minecraft:collision_box": {
				"origin": [
					-8,
					0,
					-8
				],
				"size": [
					16,
					8,
					16
				]
			},
			"minecraft:selection_box": {
				"origin": [
					-8,
					0,
					-8
				],
				"size": [
					16,
					8,
					16
				]
			},
			"zt:slab": {},
			"minecraft:tags": [
				"minecraft:is_axe_item_destructible",
				"minecraft:wood"
			],
			"minecraft:flammable": {
				"catch_chance_modifier": 5,
				"destroy_chance_modifier": 20
			},
			"minecraft:map_color": "#c8cad6"
		},
		"permutations": [
			{
				"condition": "q.block_state('minecraft:vertical_half') == 'top' && q.block_state('zt:double') == 0",
				"components": {
					"minecraft:collision_box": {
						"origin": [
							-8,
							8,
							-8
						],
						"size": [
							16,
							8,
							16
						]
					},
					"minecraft:selection_box": {
						"origin": [
							-8,
							8,
							-8
						],
						"size": [
							16,
							8,
							16
						]
					}
				}
			},
			{
				"condition": "q.block_state('zt:double') == 1",
				"components": {
					"minecraft:collision_box": true,
					"minecraft:selection_box": true,
					"minecraft:loot": "loot_tables/blocks/glowshroom_slab_double.json"
				}
			}
